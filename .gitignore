# Agent discovery paths (dev symlinks created by install.py --symlink)
.agents/
.claude/
.opencode/
.vscode/

# Internal working documents (design notes, changelog)
development/

# Temporary files
scratch/
*.log
.DS_Store
Thumbs.db

# Local secrets and environment
.env
.env.*
.envrc

# Local build outputs (the README examples write to out/) and ZIP distributions
out/
*.zip
# copies of the vendored library that --mermaid-lib link places next to outputs
# (mermaid-<version>.min.js + LICENSE.mermaid-<version>.txt); the vendored
# per-version copies under references/vendor/mermaid/<version>/ stay tracked
mermaid.min.js
mermaid-*.min.js
LICENSE.mermaid-*.txt
!skills/claude/gospelo-md2html/references/vendor/mermaid/*/mermaid.min.js

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
# the Shiki bundle's build recipe is source, not output (its own .gitignore drops node_modules)
!skills/claude/gospelo-md2html/references/vendor/shiki/build/
*.egg-info/

# md2html temporary measurement files (only left behind with MD2HTML_KEEP_TEMP=1)
.md2html-*.html
