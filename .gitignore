# Agent discovery paths (dev symlinks created by install.py --symlink)
.agents/
.claude/
.opencode/
.vscode/

# Internal working documents (design notes, changelog)
development/

# Temporary files
scratch/
*.log
.DS_Store
Thumbs.db

# Local secrets and environment
.env
.env.*
.envrc

# Local build outputs (the README examples write to out/) and ZIP distributions
out/
*.zip

# Node (the skill's npm packages; `md2html.py setup` installs them from package-lock.json)
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
# the Shiki bundle's build recipe is source, not output (its own .gitignore drops node_modules)
!skills/claude/gospelo-md2html/references/vendor/shiki/build/
*.egg-info/

# md2html temporary measurement files (only left behind with MD2HTML_KEEP_TEMP=1)
.md2html-*.html
