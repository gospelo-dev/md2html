{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gospelo-md2html content JSON",
  "type": "object",
  "required": ["version", "meta", "pages"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "date", "source"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "date": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "kind", "title", "continued", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["source", "cover", "content"] },
        "title": { "type": ["string", "null"] },
        "continued": { "type": "boolean" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "inline": { "type": "string", "description": "inline Markdown (bold, code, link) kept as text" },
    "listItem": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/inline" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/listItem" } }
      }
    },
    "block": {
      "oneOf": [
        { "type": "object", "required": ["type", "level", "text"], "additionalProperties": false,
          "properties": { "type": { "const": "heading" }, "id": { "type": "string" }, "level": { "type": "integer", "minimum": 1, "maximum": 4 }, "text": { "$ref": "#/$defs/inline" } } },
        { "type": "object", "required": ["type", "text"], "additionalProperties": false,
          "properties": { "type": { "const": "paragraph" }, "id": { "type": "string" }, "text": { "$ref": "#/$defs/inline" } } },
        { "type": "object", "required": ["type", "ordered", "items"], "additionalProperties": false,
          "properties": { "type": { "const": "list" }, "id": { "type": "string" }, "ordered": { "type": "boolean" }, "start": { "type": "integer" }, "items": { "type": "array", "items": { "$ref": "#/$defs/listItem" } } } },
        { "type": "object", "required": ["type", "header", "rows"], "additionalProperties": false,
          "properties": { "type": { "const": "table" }, "id": { "type": "string" }, "header": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inline" } }, "rows": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/inline" } } }, "align": { "type": "array", "items": { "enum": ["left", "center", "right"] } }, "continued": { "type": "boolean" } } },
        { "type": "object", "required": ["type", "lang", "lines"], "additionalProperties": false,
          "properties": { "type": { "const": "code" }, "id": { "type": "string" }, "lang": { "type": ["string", "null"] }, "lines": { "type": "array", "items": { "type": "string" } }, "continued": { "type": "boolean" } } },
        { "type": "object", "required": ["type", "src", "alt"], "additionalProperties": false,
          "properties": { "type": { "const": "image" }, "id": { "type": "string" }, "src": { "type": "string" }, "alt": { "type": "string" }, "caption": { "type": ["string", "null"] } } },
        { "type": "object", "required": ["type", "source"], "additionalProperties": false,
          "properties": { "type": { "const": "mermaid" }, "id": { "type": "string" }, "source": { "type": "string" } } },
        { "type": "object", "required": ["type", "text"], "additionalProperties": false,
          "properties": { "type": { "const": "quote" }, "id": { "type": "string" }, "text": { "$ref": "#/$defs/inline" } } },
        { "type": "object", "required": ["type", "html"], "additionalProperties": false,
          "properties": { "type": { "const": "html" }, "id": { "type": "string" }, "html": { "type": "string" } } },
        { "type": "object", "required": ["type", "text"], "additionalProperties": false,
          "properties": { "type": { "const": "markdown" }, "id": { "type": "string" }, "text": { "type": "string" } } },
        { "type": "object", "required": ["type"], "additionalProperties": false,
          "properties": { "type": { "const": "pagebreak" }, "id": { "type": "string" } } }
      ]
    }
  }
}
